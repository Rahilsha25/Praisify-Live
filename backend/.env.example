PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGINS=http://localhost:3000
DATABASE_PATH=./data/praisify.sqlite
# Optional PostgreSQL URL. When set, PostgreSQL is used instead of local SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Set these to true/none when your frontend and API are on different sites.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional Google OAuth credentials. Set all three to enable Google sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# Optional Razorpay subscription credentials. Set all six to enable billing.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_PLAN_MONTHLY_ID=
# RAZORPAY_PLAN_ANNUAL_ID=
# RAZORPAY_MONTHLY_OFFER_ID=
# RAZORPAY_WEBHOOK_SECRET=
